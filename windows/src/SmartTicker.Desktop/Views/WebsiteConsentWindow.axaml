<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:SmartTicker.Core.Services"
        x:Class="SmartTicker.Desktop.Views.WebsiteConsentWindow"
        x:DataType="services:WebsiteConsentRequest"
        Icon="/Assets/SmartTicker.ico"
        Title="Website privacy choice"
        Width="680"
        Height="570"
        MinWidth="560"
        MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="24" RowSpacing="16">
        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Text="Website privacy choice" FontSize="24" FontWeight="SemiBold" Foreground="#E6EDF3" />
            <TextBlock Text="{Binding ConsentUri.Host}" FontSize="16" Foreground="#79C0FF" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="7">
            <TextBlock Grid.Row="0" Text="Page title" Foreground="#8B949E" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="Requested source" Foreground="#8B949E" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SourceUri}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Text="Consent page" Foreground="#8B949E" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConsentUri}" TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                CornerRadius="6" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#E6EDF3" />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" TextWrapping="Wrap" Foreground="#F2B84B"
                   Text="SmartTicker will send only the privacy choice you select below, together with the hidden fields supplied by this form. Cancel sends nothing." />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel" Padding="14,7" />
            <Button Content="{Binding RejectLabel}" Click="Reject" Padding="14,7" />
            <Button Content="{Binding AcceptLabel}" Click="Accept" Classes="primary" Padding="14,7" />
        </StackPanel>
    </Grid>
</Window>