<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartTicker.Desktop.ViewModels"
        xmlns:conv="using:SmartTicker.Desktop.Converters"
        x:Class="SmartTicker.Desktop.Views.AppSettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Text.TitleAppSettings}"
        Width="900"
        Height="620"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Text="App Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Ticker layout, scrolling speed, colors, and settings backup."
                       TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="#11000000" CornerRadius="8" Padding="16">
                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="14">
                    <TextBlock Grid.Row="0" Text="Price display" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Rows" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding RowCountOptions}" SelectedItem="{Binding PriceRowCount}"
                                  Width="88" MinHeight="38" FontSize="16" FontWeight="SemiBold"
                                  Background="#202A38" Foreground="#FFFFFF" />
                        <TextBlock Text="Scroll speed" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <ComboBox ItemsSource="{Binding ScrollSpeedOptions}" SelectedItem="{Binding PriceScrollSpeed}"
                                  Width="104" MinHeight="38" FontSize="16" FontWeight="SemiBold"
                                  Background="#202A38" Foreground="#FFFFFF" />
                        <TextBlock Text="px/sec" VerticalAlignment="Center" Opacity="0.75" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="News display" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Rows" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding RowCountOptions}" SelectedItem="{Binding NewsRowCount}"
                                  Width="88" MinHeight="38" FontSize="16" FontWeight="SemiBold"
                                  Background="#202A38" Foreground="#FFFFFF" />
                        <TextBlock Text="Scroll speed" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <ComboBox ItemsSource="{Binding ScrollSpeedOptions}" SelectedItem="{Binding NewsScrollSpeed}"
                                  Width="104" MinHeight="38" FontSize="16" FontWeight="SemiBold"
                                  Background="#202A38" Foreground="#FFFFFF" />
                        <TextBlock Text="px/sec" VerticalAlignment="Center" Opacity="0.75" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Refresh every" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Prices" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding PriceRefreshSeconds}" Minimum="30" Maximum="300" Increment="15"
                                       FormatString="0" Width="126" MinHeight="38" FontSize="16" FontWeight="SemiBold"
                                       HorizontalContentAlignment="Center"
                                       Background="#202A38" Foreground="#FFFFFF" />
                        <TextBlock Text="sec" VerticalAlignment="Center" Opacity="0.75" />
                        <TextBlock Text="News" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <NumericUpDown Value="{Binding NewsRefreshSeconds}" Minimum="30" Maximum="300" Increment="15"
                                       FormatString="0" Width="126" MinHeight="38" FontSize="16" FontWeight="SemiBold"
                                       HorizontalContentAlignment="Center"
                                       Background="#202A38" Foreground="#FFFFFF" />
                        <TextBlock Text="sec" VerticalAlignment="Center" Opacity="0.75" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Colors" VerticalAlignment="Center" />
                    <WrapPanel Grid.Row="3" Grid.Column="1">
                        <StackPanel Spacing="3" Margin="0,0,10,6">
                            <TextBlock Text="Background" FontSize="12" Opacity="0.75" />
                            <ColorPicker Width="104" HorizontalAlignment="Left"
                                         Color="{Binding BackgroundColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                            <TextBox Text="{Binding BackgroundColorHex}" Width="104" MinHeight="38" FontSize="15"
                                     Background="#202A38" Foreground="#FFFFFF" />
                        </StackPanel>
                        <StackPanel Spacing="3" Margin="0,0,10,6">
                            <TextBlock Text="Quote name" FontSize="12" Opacity="0.75" />
                            <ColorPicker Width="104" HorizontalAlignment="Left"
                                         Color="{Binding SymbolColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                            <TextBox Text="{Binding SymbolColorHex}" Width="104" MinHeight="38" FontSize="15"
                                     Background="#202A38" Foreground="#FFFFFF" />
                        </StackPanel>
                        <StackPanel Spacing="3" Margin="0,0,10,6">
                            <TextBlock Text="Close price" FontSize="12" Opacity="0.75" />
                            <ColorPicker Width="104" HorizontalAlignment="Left"
                                         Color="{Binding PriceColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                            <TextBox Text="{Binding PriceColorHex}" Width="104" MinHeight="38" FontSize="15"
                                     Background="#202A38" Foreground="#FFFFFF" />
                        </StackPanel>
                        <StackPanel Spacing="3" Margin="0,0,10,6">
                            <TextBlock Text="After hours" FontSize="12" Opacity="0.75" />
                            <ColorPicker Width="104" HorizontalAlignment="Left"
                                         Color="{Binding ExtendedPriceColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                            <TextBox Text="{Binding ExtendedPriceColorHex}" Width="104" MinHeight="38" FontSize="15"
                                     Background="#202A38" Foreground="#FFFFFF" />
                        </StackPanel>
                        <StackPanel Spacing="3" Margin="0,0,10,6">
                            <TextBlock Text="News" FontSize="12" Opacity="0.75" />
                            <ColorPicker Width="104" HorizontalAlignment="Left"
                                         Color="{Binding NewsColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                            <TextBox Text="{Binding NewsColorHex}" Width="104" MinHeight="38" FontSize="15"
                                     Background="#202A38" Foreground="#FFFFFF" />
                        </StackPanel>
                        <StackPanel Spacing="3" Margin="0,0,10,6">
                            <TextBlock Text="Change up" FontSize="12" Opacity="0.75" />
                            <ColorPicker Width="104" HorizontalAlignment="Left"
                                         Color="{Binding PriceUpColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                            <TextBox Text="{Binding PriceUpColorHex}" Width="104" MinHeight="38" FontSize="15"
                                     Background="#202A38" Foreground="#FFFFFF" />
                        </StackPanel>
                        <StackPanel Spacing="3" Margin="0,0,10,6">
                            <TextBlock Text="Change down" FontSize="12" Opacity="0.75" />
                            <ColorPicker Width="104" HorizontalAlignment="Left"
                                         Color="{Binding PriceDownColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                            <TextBox Text="{Binding PriceDownColorHex}" Width="104" MinHeight="38" FontSize="15"
                                     Background="#202A38" Foreground="#FFFFFF" />
                        </StackPanel>
                        <Button Content="Reset" Command="{Binding ResetColorsCommand}" Padding="14,8"
                                Margin="0,0,0,6" VerticalAlignment="Bottom" />
                    </WrapPanel>
                    <TextBlock Grid.Row="4" Text="Backup" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Export settings…" Click="ExportSettings" Padding="18,8" />
                        <Button Content="Import settings…" Click="ImportSettings" Padding="18,8" />
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="1" Spacing="8" IsVisible="{Binding HasImportStatus}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ImportStatusIcon}" FontSize="18" FontWeight="Bold"
                                       Foreground="{Binding ImportStatusColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ImportStatusMessage}" TextWrapping="Wrap"
                                       Foreground="{Binding ImportStatusColor}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Background="#182230" CornerRadius="4" Padding="12"
                                IsVisible="{Binding HasImportProblems}">
                            <ScrollViewer MaxHeight="150">
                                <ItemsControl ItemsSource="{Binding ImportProblems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding EntryMessage}" TextWrapping="Wrap" />
    </Grid>
</Window>
