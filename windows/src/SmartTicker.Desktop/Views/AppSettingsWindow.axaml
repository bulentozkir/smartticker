<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartTicker.Desktop.ViewModels"
        xmlns:conv="using:SmartTicker.Desktop.Converters"
        x:Class="SmartTicker.Desktop.Views.AppSettingsWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/SmartTicker.ico"
        Title="{Binding Text.TitleAppSettings}"
        Width="900"
        Height="620"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="5">
                <TextBlock Text="App Settings" FontSize="24" FontWeight="SemiBold" Foreground="#E6EDF3" />
                <TextBlock Text="Ticker layout, scrolling speed, colors, and settings backup."
                           TextWrapping="Wrap" Foreground="#8B949E" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="Import Sample Quotes Config" Click="ImportSampleConfig"
                        IsEnabled="{Binding !IsLoadingStarter}" Padding="14,7" />
                <Button Content="Help" Click="ShowHelp" Padding="14,7" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="section" Text="Ticker rows and speed" />
                        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                            <TextBlock Grid.Row="0" Classes="lbl" Text="Price display" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="caption" Text="Rows" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding RowCountOptions}" SelectedItem="{Binding PriceRowCount}"
                                          Width="88" FontSize="15" FontWeight="SemiBold"
                                          IsEnabled="{Binding !UseStaticGroupedView}" />
                                <TextBlock Classes="caption" Text="Scroll speed" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <ComboBox ItemsSource="{Binding ScrollSpeedOptions}" SelectedItem="{Binding PriceScrollSpeed}"
                                          Width="104" FontSize="15" FontWeight="SemiBold"
                                          IsEnabled="{Binding !UseStaticGroupedView}" />
                                <TextBlock Classes="caption" Text="px/sec" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Classes="lbl" Text="News display" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="caption" Text="Rows" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding RowCountOptions}" SelectedItem="{Binding NewsRowCount}"
                                          Width="88" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Classes="caption" Text="Scroll speed" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <ComboBox ItemsSource="{Binding ScrollSpeedOptions}" SelectedItem="{Binding NewsScrollSpeed}"
                                          Width="104" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Classes="caption" Text="px/sec" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Classes="lbl" Text="Refresh every" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="caption" Text="Prices" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding PriceRefreshSeconds}" Minimum="30" Maximum="300" Increment="15"
                                               FormatString="0" Width="126" FontSize="15" FontWeight="SemiBold"
                                               HorizontalContentAlignment="Center"
                                               ToolTip.Tip="Price requests are spread evenly across one-second slots in this interval." />
                                <TextBlock Classes="caption" Text="sec" VerticalAlignment="Center" />
                                <TextBlock Classes="caption" Text="News" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <NumericUpDown Value="{Binding NewsRefreshSeconds}" Minimum="30" Maximum="300" Increment="15"
                                               FormatString="0" Width="126" FontSize="15" FontWeight="SemiBold"
                                               HorizontalContentAlignment="Center" />
                                <TextBlock Classes="caption" Text="sec" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Classes="lbl" Text="Font size" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="caption" Text="Scrolling" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding ScrollingViewFontSize}" Minimum="9" Maximum="24" Increment="1"
                                               FormatString="0" Width="104" FontSize="15" FontWeight="SemiBold"
                                               HorizontalContentAlignment="Center"
                                               ToolTip.Tip="Text size for scrolling price and News rows." />
                                <TextBlock Classes="caption" Text="pt" VerticalAlignment="Center" />
                                <TextBlock Classes="caption" Text="Static" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <NumericUpDown Value="{Binding StaticViewFontSize}" Minimum="9" Maximum="24" Increment="1"
                                               FormatString="0" Width="104" FontSize="15" FontWeight="SemiBold"
                                               HorizontalContentAlignment="Center"
                                               ToolTip.Tip="Text size for static quote and News rows." />
                                <TextBlock Classes="caption" Text="pt" VerticalAlignment="Center" />
                            </StackPanel>

                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="section" Text="Window sizes" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Sizes apply immediately. Width and height are stored separately for each view." />
                        <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                            <TextBlock Grid.Row="0" Classes="lbl" Text="Scrolling view" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="caption" Text="Width" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding ScrollingWindowWidth}" Minimum="420" Maximum="7680" Increment="10"
                                               FormatString="0" Width="120" FontSize="15" FontWeight="SemiBold"
                                               HorizontalContentAlignment="Center" />
                                <TextBlock Classes="caption" Text="Height" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <NumericUpDown Value="{Binding ScrollingWindowHeight}" Minimum="50" Maximum="900" Increment="10"
                                               FormatString="0" Width="120" FontSize="15" FontWeight="SemiBold"
                                               HorizontalContentAlignment="Center" />
                                <TextBlock Classes="caption" Text="px" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Classes="lbl" Text="Static Prices view" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="caption" Text="Width" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding StaticPricesWindowWidth}" Minimum="420" Maximum="7680" Increment="10"
                                               FormatString="0" Width="120" FontSize="15" FontWeight="SemiBold"
                                               HorizontalContentAlignment="Center" />
                                <TextBlock Classes="caption" Text="Height" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <NumericUpDown Value="{Binding StaticPricesWindowHeight}" Minimum="420" Maximum="4320" Increment="10"
                                               FormatString="0" Width="120" FontSize="15" FontWeight="SemiBold"
                                               HorizontalContentAlignment="Center" />
                                <TextBlock Classes="caption" Text="px" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Classes="lbl" Text="Static News view" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="caption" Text="Width" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding StaticNewsWindowWidth}" Minimum="420" Maximum="7680" Increment="10"
                                               FormatString="0" Width="120" FontSize="15" FontWeight="SemiBold"
                                               HorizontalContentAlignment="Center" />
                                <TextBlock Classes="caption" Text="Height" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <NumericUpDown Value="{Binding StaticNewsWindowHeight}" Minimum="240" Maximum="4320" Increment="10"
                                               FormatString="0" Width="120" FontSize="15" FontWeight="SemiBold"
                                               HorizontalContentAlignment="Center" />
                                <TextBlock Classes="caption" Text="px" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="section" Text="Startup" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CheckBox Content="Start SmartTicker when I sign in"
                                      IsChecked="{Binding LaunchAtLogin}"
                                      IsEnabled="{Binding IsLaunchAtLoginSupported}"
                                      VerticalAlignment="Center" />
                            <TextBlock Classes="caption" VerticalAlignment="Center"
                                       Text="Applies to this user account only."
                                       IsVisible="{Binding IsLaunchAtLoginSupported}" />
                            <TextBlock Classes="caption" VerticalAlignment="Center"
                                       Text="Not available on this platform."
                                       IsVisible="{Binding !IsLaunchAtLoginSupported}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section" Text="Website access" />
                        <CheckBox Content="Allow website cookies and cross-host redirects"
                                  IsChecked="{Binding AllowWebsiteCookiesAndCrossHostRedirects}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="When enabled, SmartTicker skips its per-source approval step, stores website cookies in memory until exit, and follows redirects to other hosts. If a website returns a recognized privacy form, SmartTicker shows it and submits only the Accept or Reject choice you click. It never uses browser cookies or submits sign-in forms." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Validate all sources" Click="ValidateAllSources" Padding="14,7" />
                            <TextBlock Text="{Binding SourceValidationStatus}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Foreground="#8B949E" />
                        </StackPanel>
                        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6"
                                Padding="12" IsVisible="{Binding HasSourceValidationProblems}">
                            <ScrollViewer MaxHeight="150">
                                <ItemsControl ItemsSource="{Binding SourceValidationProblems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,7"
                                                       FontSize="12" Foreground="#F2B84B" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="section" Text="Appearance" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Reset to defaults" Command="{Binding ResetColorsCommand}"
                                    Padding="14,7" />
                        </Grid>
                        <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="6" Width="260" HorizontalAlignment="Left"
                                        ToolTip.Tip="Lets the desktop show through the ticker background. Text stays fully opaque.">
                                <TextBlock Classes="lbl" Text="Window transparency" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Slider Value="{Binding BackgroundOpacity, Mode=TwoWay}"
                                            Minimum="0.2" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding BackgroundOpacityText}" FontSize="15"
                                               FontWeight="SemiBold" Foreground="#E6EDF3" VerticalAlignment="Center"
                                               MinWidth="46" TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <WrapPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,10">
                                <TextBlock Classes="lbl" Text="Background" />
                                <ColorPicker Width="112" HorizontalAlignment="Left"
                                             Color="{Binding BackgroundColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                                <TextBox Text="{Binding BackgroundColorHex}" Width="112" FontSize="14" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,10">
                                <TextBlock Classes="lbl" Text="Quote name" />
                                <ColorPicker Width="112" HorizontalAlignment="Left"
                                             Color="{Binding SymbolColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                                <TextBox Text="{Binding SymbolColorHex}" Width="112" FontSize="14" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,10">
                                <TextBlock Classes="lbl" Text="Close price" />
                                <ColorPicker Width="112" HorizontalAlignment="Left"
                                             Color="{Binding PriceColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                                <TextBox Text="{Binding PriceColorHex}" Width="112" FontSize="14" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,10">
                                <TextBlock Classes="lbl" Text="After hours" />
                                <ColorPicker Width="112" HorizontalAlignment="Left"
                                             Color="{Binding ExtendedPriceColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                                <TextBox Text="{Binding ExtendedPriceColorHex}" Width="112" FontSize="14" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,10">
                                <TextBlock Classes="lbl" Text="News 1st" ToolTip.Tip="Headlines 1, 5, 9 …" />
                                <ColorPicker Width="112" HorizontalAlignment="Left"
                                             Color="{Binding NewsColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                                <TextBox Text="{Binding NewsColorHex}" Width="112" FontSize="14" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,10">
                                <TextBlock Classes="lbl" Text="News 2nd" ToolTip.Tip="Headlines 2, 6, 10 …" />
                                <ColorPicker Width="112" HorizontalAlignment="Left"
                                             Color="{Binding NewsColor2Hex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                                <TextBox Text="{Binding NewsColor2Hex}" Width="112" FontSize="14" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,10">
                                <TextBlock Classes="lbl" Text="News 3rd" ToolTip.Tip="Headlines 3, 7, 11 …" />
                                <ColorPicker Width="112" HorizontalAlignment="Left"
                                             Color="{Binding NewsColor3Hex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                                <TextBox Text="{Binding NewsColor3Hex}" Width="112" FontSize="14" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,10">
                                <TextBlock Classes="lbl" Text="News 4th" ToolTip.Tip="Headlines 4, 8, 12 …" />
                                <ColorPicker Width="112" HorizontalAlignment="Left"
                                             Color="{Binding NewsColor4Hex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                                <TextBox Text="{Binding NewsColor4Hex}" Width="112" FontSize="14" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,10">
                                <TextBlock Classes="lbl" Text="Change up" Foreground="#3FB950" />
                                <ColorPicker Width="112" HorizontalAlignment="Left"
                                             Color="{Binding PriceUpColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                                <TextBox Text="{Binding PriceUpColorHex}" Width="112" FontSize="14" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,10">
                                <TextBlock Classes="lbl" Text="Change down" Foreground="#F85149" />
                                <ColorPicker Width="112" HorizontalAlignment="Left"
                                             Color="{Binding PriceDownColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                                <TextBox Text="{Binding PriceDownColorHex}" Width="112" FontSize="14" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,10">
                                <TextBlock Classes="lbl" Text="Alert blink" ToolTip.Tip="Color used while a triggered alert flashes" />
                                <ColorPicker Width="112" HorizontalAlignment="Left"
                                             Color="{Binding AlertBlinkColorHex, Mode=TwoWay, Converter={x:Static conv:HexColorConverter.Instance}}" />
                                <TextBox Text="{Binding AlertBlinkColorHex}" Width="112" FontSize="14" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="Backup" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Settings backups include quote groups. Importing replaces every configured entry and appearance setting." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Export settings…" Click="ExportSettings" Padding="18,8" />
                            <Button Content="Import settings…" Click="ImportSettings" Padding="18,8" />
                        </StackPanel>
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Alert rules live in their own file. Importing replaces every rule; rules are matched to quotes by symbol." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Export alert rules…" Click="ExportAlerts" Padding="18,8" />
                            <Button Content="Import alert rules…" Click="ImportAlerts" Padding="18,8" />
                        </StackPanel>
                        <StackPanel Spacing="8" IsVisible="{Binding HasImportStatus}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding ImportStatusIcon}" FontSize="18" FontWeight="Bold"
                                           Foreground="{Binding ImportStatusColor}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ImportStatusMessage}" TextWrapping="Wrap"
                                           Foreground="{Binding ImportStatusColor}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12"
                                    IsVisible="{Binding HasImportProblems}">
                                <ScrollViewer MaxHeight="150">
                                    <ItemsControl ItemsSource="{Binding ImportProblems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                           FontSize="12" Foreground="#F85149" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="Advanced" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Edit the configuration files directly in your text editor. SmartTicker reloads a file as soon as you save it, and rejects it if the JSON is malformed or fails schema validation. Export first; a rejected file can only be recovered from an export." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Edit Current App Config" Click="EditAppConfig" Padding="18,8" />
                            <Button Content="Edit Current Alert Rules" Click="EditAlertRules" Padding="18,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding EntryMessage}" TextWrapping="Wrap" Foreground="#8B949E" />
    </Grid>
</Window>
