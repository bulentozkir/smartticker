<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartTicker.Desktop.Views.HelpWindow"
        Icon="/Assets/SmartTicker.ico"
        Title="SmartTicker Help"
        Width="1040"
        Height="760"
        MinWidth="720"
        MinHeight="420"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="#10151D">
    <Grid Margin="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Name="HelpTitleText" Text="SmartTicker Help" FontSize="24" FontWeight="SemiBold" Foreground="#70E1A1" />
            <TextBlock Name="HelpSubtitleText" Text="Configuration guide" Opacity="0.75" />
        </StackPanel>

        <TextBlock Name="StatusText" Grid.Row="1" Text="Loading online help…" TextWrapping="Wrap" Opacity="0.8" />

        <Grid Grid.Row="2" ColumnDefinitions="220,*" ColumnSpacing="12">
            <Border Background="#0B1017" BorderBrush="#2D3748" BorderThickness="1"
                    CornerRadius="4" Padding="10">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Name="NavigationTitleText" Text="ON THIS PAGE" FontSize="11" FontWeight="SemiBold"
                               Foreground="#8B949E" Margin="8,4" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Name="NavigationPanel" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="#2D3748" BorderThickness="1"
                    CornerRadius="4" Background="#0B1017">
                <ScrollViewer Name="HelpScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Name="HelpContentHost" HorizontalContentAlignment="Stretch" />
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</Window>