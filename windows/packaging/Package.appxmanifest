<?xml version="1.0" encoding="utf-8"?>
<!--
  Identity reserved in Partner Center for Store ID 9NG2ZP5LFKDN. Publisher must stay the
  CN GUID exactly as issued; the Store rejects packages whose identity does not match.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="BulentOzkir.SmartTicker"
    Publisher="CN=06D08AF4-6BB1-40DF-9B96-5DF27BEE0635"
    Version="1.0.3.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SmartTicker</DisplayName>
    <PublisherDisplayName>Bulent Ozkir</PublisherDisplayName>
    <Description>Two-line always-on-top ticker for stocks, ETFs, commodities, and news from manually configured public sources.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="SmartTicker" Executable="SmartTicker.Desktop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="SmartTicker"
        Description="Two-line always-on-top ticker for stocks, ETFs, commodities, and news."
        BackgroundColor="#10151D"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension
          Category="windows.startupTask"
          Executable="SmartTicker.Desktop.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="SmartTickerStartupTask"
            Enabled="false"
            DisplayName="SmartTicker" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
