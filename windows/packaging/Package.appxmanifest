<?xml version="1.0" encoding="utf-8"?>
<!--
  Development identity only. Replace Name, Publisher, and PublisherDisplayName with the
  values reserved in Microsoft Partner Center before submitting to the Microsoft Store.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="BulentOzkir.SmartTicker"
    Publisher="CN=Bulent Ozkir"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SmartTicker</DisplayName>
    <PublisherDisplayName>Bulent Ozkir</PublisherDisplayName>
    <Description>Two-line always-on-top ticker for stocks, ETFs, commodities, and news from manually configured public sources.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="SmartTicker" Executable="SmartTicker.Desktop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="SmartTicker"
        Description="Two-line always-on-top ticker for stocks, ETFs, commodities, and news."
        BackgroundColor="#10151D"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
